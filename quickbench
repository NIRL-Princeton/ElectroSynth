static void BM_FuncPtr(benchmark::State& state) {
    int dummy = 0;
    for (auto _ : state) {
        for (int i = 0; i < 1000; ++i)
            dummy += funcptrs[i % numFuncs]();
    }
    benchmark::DoNotOptimize(dummy);
}

static void BM_Switch(benchmark::State& state) {
    int dummy = 0;
    for (auto _ : state) {
        for (int i = 0; i < 1000; ++i)
            dummy += switchdispatch(i % numFuncs);
    }
    benchmark::DoNotOptimize(dummy);
}
 auto vtable = make_virtual_objects();
static void BM_Virtual(benchmark::State& state) {

    int dummy = 0;
    for (auto _ : state) {
        for (int i = 0; i < 1000; ++i)
            dummy += vtable[i % numFuncs]->call();
    }
    benchmark::DoNotOptimize(dummy);
}

// Register benchmarks
BENCHMARK(BM_FuncPtr);
BENCHMARK(BM_Switch);
BENCHMARK(BM_Virtual);
BENCHMARK(BM_std_visit_10);
